# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...   # the anon/publishable key
SUPABASE_SECRET_KEY=eyJ...                     # service-role key, server-side only (webhook bypasses RLS)

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Cookies ---
# Optional. Set to .finnoybu.org only if you want one session shared across
# *.finnoybu.org subdomains. For single-subdomain (just press.finnoybu.org),
# leave UNSET — cookies default to current host.
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- OAuth providers ---
# Apple, GitHub, Facebook, Google credentials are configured in
# Supabase Dashboard → Authentication → Providers, NOT here. Each
# provider's redirect URI should point to:
#   https://YOUR-PROJECT.supabase.co/auth/v1/callback
