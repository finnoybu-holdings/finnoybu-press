# --- Site ---
PUBLIC_SITE_URL=http://localhost:4321

# --- Supabase ---
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SECRET_KEY=eyJ...                  # service-role key, server-side only (webhook bypasses RLS)

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Cookies ---
# Domain for auth cookies. Use .finnoybu.org in prod ONLY if you want one
# session shared across press.finnoybu.org and any future *.finnoybu.org
# subdomains. For a single-subdomain setup, leave this UNSET — Supabase will
# default to the current host, which is what works in 99% of cases. Must
# carry the PUBLIC_ prefix so the browser bundle can read it.
PUBLIC_AUTH_COOKIE_DOMAIN=

# --- OAuth providers (configured in Supabase dashboard, NOT here) ---
# Apple, GitHub, Facebook, Google credentials are configured in
# Supabase → Authentication → Providers. The redirect URI for each
# provider should point to: https://YOUR-PROJECT.supabase.co/auth/v1/callback
