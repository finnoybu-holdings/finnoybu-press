# --- Site ---
PUBLIC_SITE_URL=http://localhost:4321

# --- Better Auth ---
# Generate with: openssl rand -hex 32  (or any 32-byte random string)
BETTER_AUTH_SECRET=replace-with-32-byte-random-hex

# --- AWS SES (transactional email — sign-in links) ---
# Use an IAM user limited to ses:SendEmail. Verify the sender identity for
# the EMAIL_FROM domain in the SES console first.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
EMAIL_FROM=Finnoybu Press <hello@press.finnoybu.org>

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Notes ---
# In production these go in the Cloudflare dashboard:
#   Pages → finnoybu-press → Settings → Environment variables (and Secrets).
# D1 (DB) and R2 (PDFS) bindings are wired via wrangler.toml, not env vars.
