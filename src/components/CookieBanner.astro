---
// CookieBanner — port of finnoybu-trilogy/components/CookieBanner.tsx
// to Astro vanilla JS. Shows a fixed-bottom acknowledgement banner on
// first visit (and again if 24h have passed since the user last
// dismissed it). Acceptance timestamp is stored in localStorage.
---

<aside id="cookie-banner" class="cookie-banner" hidden>
  <div class="banner-inner">
    <p class="banner-msg">
      This site uses cookies and local storage for authentication, cart
      persistence, and analytics.
      <a href="/legal#cookie-policy" class="learn-more">Learn more</a>
    </p>
    <button type="button" class="accept-btn" data-accept-cookies>Got it</button>
  </div>
</aside>

<script>
  const STORAGE_KEY = 'finnoybu-press-cookies-accepted';
  const REFRESH_AFTER_MS = 24 * 60 * 60 * 1000; // 24h — re-prompt to keep consent fresh

  const banner = document.getElementById('cookie-banner') as HTMLElement | null;
  if (banner) {
    let shouldShow = true;
    try {
      const accepted = localStorage.getItem(STORAGE_KEY);
      if (accepted && Date.now() - Number(accepted) < REFRESH_AFTER_MS) {
        shouldShow = false;
      }
    } catch {
      // localStorage may be unavailable (incognito, blocked) — show the
      // banner anyway; acceptance just won't persist.
    }
    if (shouldShow) banner.hidden = false;

    banner.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-accept-cookies]')) {
        try { localStorage.setItem(STORAGE_KEY, String(Date.now())); } catch {}
        banner.hidden = true;
      }
    });
  }
</script>

<style>
  .cookie-banner {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    padding: 1rem;
    pointer-events: none; /* let clicks pass through outside the inner card */
  }
  @media (min-width: 640px) {
    .cookie-banner { padding: 1.5rem; }
  }

  .banner-inner {
    pointer-events: auto;
    max-width: 36rem;
    margin: 0 auto;
    background: var(--paper, #f5efe2);
    border: 1px solid var(--ink-200, #d4cab2);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    align-items: flex-start;
    box-shadow: 0 20px 40px -16px rgba(26, 22, 20, 0.32);
  }
  @media (min-width: 640px) {
    .banner-inner {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
  }

  .banner-msg {
    font-family: var(--serif, Georgia, serif);
    font-size: 0.875rem;
    color: var(--ink-700, #2e2820);
    line-height: 1.55;
    flex: 1;
    margin: 0;
  }
  .learn-more {
    color: var(--accent-color, #156082);
    text-decoration: underline;
  }
  .learn-more:hover { color: var(--ink-900, #1c1814); }

  .accept-btn {
    flex-shrink: 0;
    background: var(--ink-900, #1c1814);
    color: var(--paper, #f5efe2);
    border: 0;
    padding: 0.5rem 1.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
    height: 2.25rem;
    align-self: stretch;
  }
  @media (min-width: 640px) {
    .accept-btn { align-self: auto; }
  }
  .accept-btn:hover { background: #2e2820; }
</style>
