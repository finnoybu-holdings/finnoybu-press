---
// AddToCartButton — adds a book by slug to the local-storage cart.
// Toggles label between "Add to cart" and "In cart ✓" based on current state.

interface Props {
  slug: string;
  price?: string;       // display price; defaults to "$7.49"
  variant?: 'primary' | 'secondary';
}

const { slug, price = '$7.49', variant = 'primary' } = Astro.props;
---

<button
  type="button"
  class={`add-to-cart ${variant}`}
  data-add-to-cart
  data-slug={slug}
>
  <span class="cta-row">
    <span class="cta-label">Add to cart</span>
    <span class="cta-price">{price}</span>
  </span>
  <span class="cta-hint">PDF + ePub bundle</span>
</button>

<script>
  import { addToCart, removeFromCart, isInCart, onCartChange } from '../lib/cart';

  function refresh(btn: HTMLButtonElement) {
    const slug = btn.dataset.slug;
    if (!slug) return;
    const inCart = isInCart(slug);
    btn.classList.toggle('in-cart', inCart);
    const label = btn.querySelector<HTMLSpanElement>('.cta-label');
    if (label) label.textContent = inCart ? 'In cart — remove' : 'Add to cart';
  }

  function bind(btn: HTMLButtonElement) {
    refresh(btn);
    btn.addEventListener('click', () => {
      const slug = btn.dataset.slug;
      if (!slug) return;
      if (isInCart(slug)) {
        removeFromCart(slug);
      } else {
        addToCart(slug);
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach(bind);

  // Keep button label in sync with cart changes (e.g., removed from /cart page)
  onCartChange(() => {
    document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach(refresh);
  });
</script>

<style>
  .add-to-cart {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0.875rem 1rem;
    background: color-mix(in srgb, var(--accent-color, #1c1814) 18%, var(--paper, #f5efe2));
    border: 1px solid var(--accent-color, #1c1814);
    color: var(--accent-color, #1c1814);
    cursor: pointer;
    text-align: left;
    transition: background 0.15s, transform 0.15s;
    font-family: inherit;
  }
  .add-to-cart:hover {
    background: color-mix(in srgb, var(--accent-color, #1c1814) 28%, var(--paper));
    transform: translateY(-1px);
  }
  .add-to-cart.in-cart {
    background: var(--paper);
  }
  .add-to-cart.secondary {
    background: var(--paper);
  }
  .cta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .cta-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .cta-price {
    font-family: var(--serif, Georgia, serif);
    font-size: 1.375rem;
    font-weight: 600;
  }
  .cta-hint {
    font-size: 0.75rem;
    color: var(--ink-500, #6e665a);
    margin-top: 0.15rem;
  }
</style>
