---
// BundleCTA — promotes a bundle (Collection or Series) with a one-click
// add-to-cart action. Renders a banner with label, savings, current price,
// and a button. Adds the bundle to the client-side cart and removes any
// individually-cart'd items it subsumes.
import { BUNDLES, bundleTotalCents } from '../lib/bundles';
import { getCollection } from 'astro:content';

interface Props {
  bundleId: string;
}

const { bundleId } = Astro.props;
const bundle = BUNDLES.find((b) => b.id === bundleId);
if (!bundle) throw new Error(`Unknown bundle: ${bundleId}`);

const allBooks = await getCollection('books');
const allToolkits = await getCollection('toolkits');

function priceCents(s: string): number {
  const c = (s || '').replace(/[^0-9.]/g, '');
  return c ? Math.round(parseFloat(c) * 100) : 0;
}

const bookCatalog = allBooks.map((b) => {
  const fmt = b.data.formats.find((f: any) => f.type === 'pdf-epub');
  return { slug: b.slug, number: b.data.number, price_cents: priceCents(fmt?.price ?? '') };
});
const toolkitCatalog = allToolkits.map((t) => {
  const fmt = t.data.formats.find((f: any) => f.type === 'pdf-epub');
  return { slug: t.slug, number: t.data.number, price_cents: priceCents(fmt?.price ?? '') };
});

const totals = bundleTotalCents(bundle, bookCatalog, toolkitCatalog);

function fmtCents(cents: number): string {
  return '$' + (cents / 100).toFixed(2);
}

const includedShort = bundle.bookNumbers.length > 0 && bundle.toolkitSlugs.length > 0
  ? `${bundle.bookNumbers.length} books + ${bundle.toolkitSlugs.length} toolkits`
  : bundle.bookNumbers.length > 0
    ? `${bundle.bookNumbers.length} books`
    : `${bundle.toolkitSlugs.length} toolkits`;
---
<aside class="bundle-cta" style={`--bundle-accent: ${bundle.accentColor}`}>
  <div class="bundle-info">
    <p class="eyebrow">Bundle · Save {bundle.discountPercent}%</p>
    <h2>{bundle.label}</h2>
    <p class="bundle-desc">{bundle.description}</p>
    <p class="bundle-meta">{includedShort} · PDF + ePub digital editions</p>
  </div>
  <div class="bundle-price-block">
    <p class="bundle-strike">{fmtCents(totals.gross_cents)}</p>
    <p class="bundle-price">{fmtCents(totals.net_cents)}</p>
    <p class="bundle-savings">You save {fmtCents(totals.gross_cents - totals.net_cents)}</p>
    <button
      type="button"
      class="bundle-btn"
      data-add-bundle={bundle.id}
      data-included-books={JSON.stringify(totals.included_book_slugs)}
      data-included-toolkits={JSON.stringify(totals.included_toolkit_slugs)}
    >
      <span class="btn-label">Add bundle to cart</span>
    </button>
  </div>
</aside>

<script>
  import { addBundleToCart, removeBundleFromCart, isBundleInCart, onCartChange } from '../lib/cart';

  function refresh() {
    document.querySelectorAll<HTMLButtonElement>('[data-add-bundle]').forEach((btn) => {
      const id = btn.dataset.addBundle;
      if (!id) return;
      const inCart = isBundleInCart(id);
      btn.classList.toggle('in-cart', inCart);
      const label = btn.querySelector<HTMLSpanElement>('.btn-label');
      if (label) label.textContent = inCart ? 'In cart — remove bundle' : 'Add bundle to cart';
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-add-bundle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.addBundle;
      if (!id) return;
      if (isBundleInCart(id)) {
        removeBundleFromCart(id);
      } else {
        const books: string[] = JSON.parse(btn.dataset.includedBooks || '[]');
        const toolkits: string[] = JSON.parse(btn.dataset.includedToolkits || '[]');
        addBundleToCart(id, books, toolkits);
      }
    });
  });

  onCartChange(refresh);
  refresh();
</script>

<style>
  .bundle-cta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    padding: var(--space-3);
    background: color-mix(in srgb, var(--bundle-accent) 8%, var(--paper));
    border: 1px solid var(--bundle-accent);
    border-left-width: 4px;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 700px) {
    .bundle-cta {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: var(--space-4);
      gap: var(--space-4);
    }
  }

  .eyebrow {
    color: var(--bundle-accent);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    margin: 0 0 0.4rem;
  }
  .bundle-info h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1.15;
    margin: 0 0 0.5rem;
    color: var(--ink-900);
  }
  .bundle-desc {
    color: var(--ink-700);
    font-size: 0.9375rem;
    margin: 0 0 0.4rem;
    max-width: 48ch;
  }
  .bundle-meta {
    color: var(--ink-500);
    font-size: 0.8125rem;
    margin: 0;
  }

  .bundle-price-block {
    text-align: left;
  }
  @media (min-width: 700px) { .bundle-price-block { text-align: right; min-width: 200px; } }

  .bundle-strike {
    color: var(--ink-500);
    font-size: 0.875rem;
    text-decoration: line-through;
    margin: 0;
  }
  .bundle-price {
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 600;
    color: var(--bundle-accent);
    margin: 0.1rem 0;
    line-height: 1;
  }
  .bundle-savings {
    color: #2e8a5f;
    font-size: 0.8125rem;
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }

  .bundle-btn {
    display: inline-block;
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    background: var(--bundle-accent);
    color: var(--paper);
    border: 0;
    padding: 0.75rem 1.25rem;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: filter 0.15s;
  }
  @media (min-width: 700px) { .bundle-btn { width: auto; } }
  .bundle-btn:hover { filter: brightness(0.92); }
  .bundle-btn.in-cart {
    background: var(--paper);
    color: var(--bundle-accent);
    border: 1px solid var(--bundle-accent);
  }
</style>
