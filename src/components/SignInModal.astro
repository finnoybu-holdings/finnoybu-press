---
// SignInModal — port of the fiction-site auth flow (finnoybu-trilogy
// AuthModal.tsx) into Astro vanilla JS. Four views switched in-place
// without page navigation: sign_in / sign_up / forgot_password / check_email.
// Opens via [data-open-signin] on any element. Closes on backdrop click,
// Esc, or the close button.
---

<dialog id="signin-modal" class="signin-modal" aria-labelledby="signin-title">
  <div class="modal-card">
    <div class="modal-head">
      <h2 id="signin-title">Sign in</h2>
      <button type="button" class="close" data-close-signin aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>

    <!-- Check-email view: shown after sign-up or forgot-password submit -->
    <div class="check-email-view" hidden>
      <p class="check-email-msg">
        We've sent a link to <strong id="check-email-address"></strong>.
        Check your inbox to continue.
      </p>
      <button type="button" class="back-to-signin link" data-goto="sign_in">Back to sign in</button>
    </div>

    <!-- Auth-form view: sign_in / sign_up / forgot_password share this region -->
    <div class="auth-form-view">
      <!-- OAuth grid (hidden on forgot_password) -->
      <div class="oauth-grid">
        <button type="button" class="oauth-btn" data-provider="apple" aria-label="Continue with Apple">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
          </svg>
          Apple
        </button>
        <button type="button" class="oauth-btn" data-provider="github" aria-label="Continue with GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </button>
        <button type="button" class="oauth-btn" data-provider="facebook" aria-label="Continue with Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Facebook
        </button>
        <button type="button" class="oauth-btn" data-provider="google" aria-label="Continue with Google">
          <svg width="18" height="18" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Google
        </button>
      </div>

      <div class="divider"><span>or</span></div>

      <form class="email-form" id="signin-form" novalidate>
        <label>
          <span class="field-label">Email</span>
          <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
        </label>

        <label class="password-field">
          <span class="field-label">Password</span>
          <input type="password" name="password" autocomplete="current-password" placeholder="At least 8 characters" minlength="8" required />
        </label>

        <!-- Password strength (sign_up only) -->
        <div class="password-strength" hidden>
          <div class="strength-bars">
            <span class="bar" data-bar="0"></span>
            <span class="bar" data-bar="1"></span>
            <span class="bar" data-bar="2"></span>
            <span class="bar" data-bar="3"></span>
            <span class="bar" data-bar="4"></span>
          </div>
          <p class="strength-label"></p>
        </div>

        <!-- Confirm password (sign_up only) -->
        <label class="confirm-field" hidden>
          <span class="field-label">Confirm password</span>
          <input type="password" name="confirm_password" autocomplete="new-password" placeholder="Re-enter your password" minlength="8" />
        </label>

        <p class="form-error" id="signin-error" hidden></p>

        <button type="submit" class="submit">Sign in</button>
      </form>

      <div class="form-links">
        <button type="button" class="link" data-goto="forgot_password" data-show-on="sign_in">Forgot password?</button>
        <p class="form-toggle" data-show-on="sign_in">
          Don't have an account?
          <button type="button" class="link" data-goto="sign_up">Sign up</button>
        </p>
        <p class="form-toggle" data-show-on="sign_up" hidden>
          Already have an account?
          <button type="button" class="link" data-goto="sign_in">Sign in</button>
        </p>
        <button type="button" class="link" data-goto="sign_in" data-show-on="forgot_password" hidden>Back to sign in</button>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { getBrowserClient } from '../lib/supabase/client';

  type View = 'sign_in' | 'sign_up' | 'forgot_password' | 'check_email';

  const modal = document.getElementById('signin-modal') as HTMLDialogElement | null;
  if (!modal) {
    // No modal in DOM (e.g., user is signed in and SignInModal isn't rendered).
    // Skip wiring entirely.
  } else {
    const form = modal.querySelector<HTMLFormElement>('#signin-form');
    const errorEl = modal.querySelector<HTMLParagraphElement>('#signin-error');
    const titleEl = modal.querySelector<HTMLElement>('#signin-title');
    const submitBtn = form?.querySelector<HTMLButtonElement>('button.submit');
    const passwordInput = form?.querySelector<HTMLInputElement>('input[name="password"]');
    const confirmField = modal.querySelector<HTMLLabelElement>('.confirm-field');
    const confirmInput = confirmField?.querySelector<HTMLInputElement>('input[name="confirm_password"]');
    const passwordField = modal.querySelector<HTMLLabelElement>('.password-field');
    const strengthBlock = modal.querySelector<HTMLDivElement>('.password-strength');
    const strengthLabel = strengthBlock?.querySelector<HTMLParagraphElement>('.strength-label');
    const strengthBars = strengthBlock?.querySelectorAll<HTMLSpanElement>('.bar');
    const oauthGrid = modal.querySelector<HTMLDivElement>('.oauth-grid');
    const divider = modal.querySelector<HTMLDivElement>('.divider');
    const checkEmailView = modal.querySelector<HTMLDivElement>('.check-email-view');
    const authFormView = modal.querySelector<HTMLDivElement>('.auth-form-view');
    const checkEmailAddress = modal.querySelector<HTMLElement>('#check-email-address');

    let view: View = 'sign_in';
    let loading = false;

    // Lightweight password strength heuristic. zxcvbn is 400KB; this is a
    // quick approximation: length + character-class diversity. Returns
    // 0–4 (matching zxcvbn's scale) with a label.
    function strengthScore(pw: string): { score: number; label: string } {
      if (!pw) return { score: 0, label: '' };
      let score = 0;
      if (pw.length >= 8) score++;
      if (pw.length >= 12) score++;
      const classes = [/[a-z]/, /[A-Z]/, /\d/, /[^a-zA-Z0-9]/].filter((re) => re.test(pw)).length;
      score += Math.max(0, classes - 1);
      score = Math.min(4, score);
      const labels = ['Very weak', 'Weak', 'Fair', 'Strong', 'Very strong'];
      return { score, label: labels[score] };
    }

    function updateStrength() {
      if (!strengthBlock || !strengthBars || !strengthLabel) return;
      const pw = passwordInput?.value ?? '';
      if (view !== 'sign_up' || !pw) {
        strengthBlock.hidden = true;
        return;
      }
      strengthBlock.hidden = false;
      const { score, label } = strengthScore(pw);
      strengthBars.forEach((bar, i) => {
        bar.classList.toggle('active', i <= score);
        bar.dataset.score = String(score);
      });
      strengthLabel.textContent = label;
      strengthLabel.dataset.score = String(score);
    }

    function setLoading(next: boolean) {
      loading = next;
      if (submitBtn) {
        submitBtn.disabled = next;
        submitBtn.textContent = next ? 'Please wait…' : (
          view === 'sign_in' ? 'Sign in' :
          view === 'sign_up' ? 'Create account' :
          'Send reset link'
        );
      }
      modal!.querySelectorAll<HTMLButtonElement>('.oauth-btn').forEach((b) => { b.disabled = next; });
    }

    function showError(msg: string | null) {
      if (!errorEl) return;
      if (msg) {
        errorEl.textContent = msg;
        errorEl.hidden = false;
      } else {
        errorEl.textContent = '';
        errorEl.hidden = true;
      }
    }

    function setView(next: View) {
      view = next;
      showError(null);

      if (next === 'check_email') {
        if (authFormView) authFormView.hidden = true;
        if (checkEmailView) checkEmailView.hidden = false;
        if (titleEl) titleEl.textContent = 'Check your email';
        return;
      }

      if (authFormView) authFormView.hidden = false;
      if (checkEmailView) checkEmailView.hidden = true;

      if (titleEl) {
        titleEl.textContent =
          next === 'sign_in' ? 'Sign in' :
          next === 'sign_up' ? 'Create account' :
          'Reset password';
      }

      // OAuth + divider only on sign_in / sign_up
      const showOAuth = next === 'sign_in' || next === 'sign_up';
      if (oauthGrid) oauthGrid.hidden = !showOAuth;
      if (divider) divider.hidden = !showOAuth;

      // Password field hidden on forgot_password
      if (passwordField) passwordField.hidden = next === 'forgot_password';

      // Confirm + strength only on sign_up
      const isSignUp = next === 'sign_up';
      if (confirmField) confirmField.hidden = !isSignUp;
      if (confirmInput) confirmInput.required = isSignUp;
      updateStrength();

      // Autocomplete hint flips based on view
      if (passwordInput) {
        passwordInput.autocomplete = isSignUp ? 'new-password' : 'current-password';
      }

      // Toggle the form-link rows that show only on a particular view
      modal!.querySelectorAll<HTMLElement>('[data-show-on]').forEach((el) => {
        el.hidden = el.dataset.showOn !== next;
      });

      if (submitBtn) {
        submitBtn.textContent =
          next === 'sign_in' ? 'Sign in' :
          next === 'sign_up' ? 'Create account' :
          'Send reset link';
      }
    }

    // Open / close triggers
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-open-signin]')) {
        e.preventDefault();
        setView('sign_in');
        modal.showModal();
      } else if (target.closest('[data-close-signin]')) {
        modal.close();
      } else if (e.target === modal) {
        // Native dialog backdrop click
        modal.close();
      }
    });

    // View navigation buttons (data-goto)
    modal.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest<HTMLElement>('[data-goto]');
      if (!trigger) return;
      const next = trigger.dataset.goto as View;
      if (next) setView(next);
    });

    // Update strength meter as user types
    passwordInput?.addEventListener('input', updateStrength);

    // Email/password submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (loading) return;
      showError(null);

      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      const password = String(fd.get('password') || '');
      const confirmPassword = String(fd.get('confirm_password') || '');

      if (!email) { showError('Email is required.'); return; }

      const supabase = getBrowserClient();
      setLoading(true);

      try {
        if (view === 'sign_up') {
          const { score } = strengthScore(password);
          if (score < 2) { showError('Please choose a stronger password.'); setLoading(false); return; }
          if (password !== confirmPassword) { showError('Passwords do not match.'); setLoading(false); return; }
          const { error } = await supabase.auth.signUp({
            email,
            password,
            options: { emailRedirectTo: `${window.location.origin}/auth/confirmed` },
          });
          if (error) { showError(error.message); setLoading(false); return; }
          if (checkEmailAddress) checkEmailAddress.textContent = email;
          setView('check_email');
        } else if (view === 'sign_in') {
          const { error } = await supabase.auth.signInWithPassword({ email, password });
          if (error) { showError(error.message); setLoading(false); return; }
          // Reload so server-rendered state (Nav, cart, etc.) picks up the session.
          window.location.reload();
        } else if (view === 'forgot_password') {
          const { error } = await supabase.auth.resetPasswordForEmail(email, {
            redirectTo: `${window.location.origin}/auth/callback?next=/account/update-password`,
          });
          if (error) { showError(error.message); setLoading(false); return; }
          if (checkEmailAddress) checkEmailAddress.textContent = email;
          setView('check_email');
        }
      } catch (err: any) {
        showError(err?.message ?? 'Something went wrong. Try again.');
      } finally {
        setLoading(false);
      }
    });

    // OAuth providers
    modal.querySelectorAll<HTMLButtonElement>('.oauth-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (loading) return;
        showError(null);
        setLoading(true);
        const provider = btn.dataset.provider as 'apple' | 'github' | 'facebook' | 'google';
        const supabase = getBrowserClient();
        try {
          const { error } = await supabase.auth.signInWithOAuth({
            provider,
            options: {
              redirectTo: `${window.location.origin}/auth/callback?next=${encodeURIComponent(window.location.pathname)}`,
            },
          });
          if (error) { showError(error.message); setLoading(false); }
        } catch (err: any) {
          showError(err?.message ?? 'OAuth sign-in failed.');
          setLoading(false);
        }
      });
    });
  }
</script>

<style>
  .signin-modal {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 420px;
    width: 90vw;
    inset: 0;
    margin: auto;
  }
  .signin-modal::backdrop {
    background: rgba(26, 22, 20, 0.55);
    backdrop-filter: blur(2px);
  }
  .modal-card {
    background: var(--paper, #f5efe2);
    border: 1px solid var(--ink-200, #d4cab2);
    padding: 1.75rem 1.5rem 1.5rem;
    box-shadow: 0 30px 60px -20px rgba(26, 22, 20, 0.35);
    color: var(--ink-900, #1c1814);
    border-radius: 6px;
  }

  .modal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .modal-head h2 {
    font-family: var(--serif, Georgia, serif);
    font-size: 1.5rem;
    margin: 0;
  }
  .close {
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--ink-500, #6e665a);
    padding: 0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .close:hover { color: var(--ink-900); }

  /* Check-email view */
  .check-email-view {
    text-align: center;
    padding: 0.5rem 0 0.25rem;
  }
  .check-email-msg {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--ink-700, #2e2820);
    line-height: 1.55;
    margin: 0;
  }
  .check-email-view .back-to-signin {
    margin-top: 1.5rem;
    font-size: 0.875rem;
  }

  /* OAuth grid */
  .oauth-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .oauth-btn {
    background: var(--paper);
    border: 1px solid var(--ink-200);
    padding: 0.625rem 0.75rem;
    cursor: pointer;
    font-size: 0.9375rem;
    color: var(--ink-900);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 4px;
    transition: border-color 0.15s, background 0.15s;
  }
  .oauth-btn:hover { border-color: var(--ink-500); background: #ede5cf; }
  .oauth-btn:disabled { opacity: 0.5; cursor: default; }
  .oauth-btn svg { flex: none; }

  /* Divider */
  .divider {
    text-align: center;
    margin: 0.75rem 0 1rem;
    position: relative;
    color: var(--ink-500);
    font-size: 0.8125rem;
  }
  .divider::before,
  .divider::after {
    content: '';
    position: absolute;
    top: 50%;
    width: calc(50% - 1.5rem);
    height: 1px;
    background: var(--ink-200);
  }
  .divider::before { left: 0; }
  .divider::after { right: 0; }
  .divider span { background: var(--paper); padding: 0 0.5rem; }

  /* Form */
  .email-form {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .email-form label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .field-label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-500);
    font-weight: 600;
  }
  .email-form input {
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--ink-200);
    background: var(--paper);
    font-size: 0.9375rem;
    font-family: inherit;
    color: var(--ink-900);
    border-radius: 4px;
  }
  .email-form input:focus {
    outline: 2px solid var(--ink-700, #2e2820);
    outline-offset: -1px;
  }

  /* Password strength */
  .password-strength {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .strength-bars {
    display: flex;
    gap: 0.25rem;
  }
  .strength-bars .bar {
    flex: 1;
    height: 3px;
    background: var(--ink-200);
    border-radius: 2px;
    transition: background-color 0.15s;
  }
  .strength-bars .bar.active[data-score="0"] { background: #8b4049; }
  .strength-bars .bar.active[data-score="1"] { background: #9e6a3a; }
  .strength-bars .bar.active[data-score="2"] { background: #8a7e3e; }
  .strength-bars .bar.active[data-score="3"] { background: #4a7a5c; }
  .strength-bars .bar.active[data-score="4"] { background: #2a6b5a; }
  .strength-label {
    font-size: 0.75rem;
    color: var(--ink-500);
    margin: 0;
  }
  .strength-label[data-score="3"],
  .strength-label[data-score="4"] { color: #4a7a5c; }

  /* Error */
  .form-error {
    margin: 0;
    color: #a13d2c;
    font-size: 0.875rem;
  }

  /* Submit */
  .submit {
    background: var(--ink-900);
    color: var(--paper);
    border: 0;
    padding: 0.75rem;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    margin-top: 0.25rem;
    border-radius: 4px;
  }
  .submit:hover { background: #2e2820; }
  .submit:disabled { opacity: 0.6; cursor: default; }

  /* Form links */
  .form-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--ink-500);
    margin-top: 1rem;
  }
  .form-toggle { margin: 0; }
  .link {
    background: transparent;
    border: 0;
    color: var(--ink-900);
    cursor: pointer;
    text-decoration: underline;
    font-size: inherit;
    padding: 0;
  }
  .link:hover { color: var(--accent-color, #156082); }
</style>
