---
// SignInModal — direct port of finnoybu-trilogy/components/AuthModal.tsx
// to Astro + vanilla JS. Behaviour, view-state machine, validation
// thresholds, error messages, redirect targets, and visual layout
// (top-aligned at 20vh, not vertically centered) match the fiction
// site one-to-one.
---

<dialog id="signin-modal" class="signin-modal" aria-labelledby="signin-title">
  <div class="modal-backdrop" data-close-signin></div>
  <div class="modal-card">
    <div class="modal-head">
      <h2 id="signin-title">Sign in</h2>
      <button type="button" class="close" data-close-signin aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>

    <div class="modal-body">
      <!-- Check-email view -->
      <div class="check-email-view" hidden>
        <p class="check-email-msg">
          We've sent a link to <strong id="check-email-address"></strong>.
          Check your inbox to continue.
        </p>
        <button type="button" class="link back-to-signin" data-goto="sign_in">Back to sign in</button>
      </div>

      <!-- Auth-form view (sign_in / sign_up / forgot_password) -->
      <div class="auth-form-view">
        <div class="oauth-grid">
          <button type="button" class="oauth-btn" data-provider="apple" aria-label="Continue with Apple">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
            </svg>
            Apple
          </button>
          <button type="button" class="oauth-btn" data-provider="github" aria-label="Continue with GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </button>
          <button type="button" class="oauth-btn" data-provider="facebook" aria-label="Continue with Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </button>
          <button type="button" class="oauth-btn" data-provider="google" aria-label="Continue with Google">
            <svg width="18" height="18" viewBox="0 0 24 24">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Google
          </button>
        </div>

        <div class="divider"><span>or</span></div>

        <form class="email-form" id="signin-form" novalidate>
          <label class="field">
            <span class="field-label">Email</span>
            <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
          </label>

          <label class="field password-field">
            <span class="field-label">Password</span>
            <input type="password" name="password" autocomplete="current-password" placeholder="At least 8 characters" minlength="8" required />
          </label>

          <div class="password-strength" hidden>
            <div class="strength-bars">
              <span class="bar"></span>
              <span class="bar"></span>
              <span class="bar"></span>
              <span class="bar"></span>
              <span class="bar"></span>
            </div>
            <p class="strength-label"></p>
          </div>

          <label class="field confirm-field" hidden>
            <span class="field-label">Confirm password</span>
            <input type="password" name="confirm_password" autocomplete="new-password" placeholder="Re-enter your password" minlength="8" />
          </label>

          <p class="form-error" hidden></p>

          <button type="submit" class="submit">Sign in</button>
        </form>

        <div class="form-links">
          <button type="button" class="link signin-only" data-goto="forgot_password">Forgot password?</button>
          <p class="form-toggle signin-only">
            Don't have an account?
            <button type="button" class="link link-accent" data-goto="sign_up">Sign up</button>
          </p>
          <p class="form-toggle signup-only" hidden>
            Already have an account?
            <button type="button" class="link link-accent" data-goto="sign_in">Sign in</button>
          </p>
          <button type="button" class="link forgot-only" data-goto="sign_in" hidden>Back to sign in</button>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { getBrowserClient } from '../lib/supabase/client';
  import zxcvbn from 'zxcvbn';

  type View = 'sign_in' | 'sign_up' | 'forgot_password' | 'check_email';

  const modal = document.getElementById('signin-modal') as HTMLDialogElement | null;
  if (modal) {
    const form = modal.querySelector<HTMLFormElement>('#signin-form');
    const errorEl = modal.querySelector<HTMLParagraphElement>('.form-error');
    const titleEl = modal.querySelector<HTMLElement>('#signin-title');
    const submitBtn = form?.querySelector<HTMLButtonElement>('button.submit');
    const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');
    const passwordInput = form?.querySelector<HTMLInputElement>('input[name="password"]');
    const confirmInput = form?.querySelector<HTMLInputElement>('input[name="confirm_password"]');
    const passwordField = modal.querySelector<HTMLLabelElement>('.password-field');
    const confirmField = modal.querySelector<HTMLLabelElement>('.confirm-field');
    const strengthBlock = modal.querySelector<HTMLDivElement>('.password-strength');
    const strengthBars = strengthBlock?.querySelectorAll<HTMLSpanElement>('.bar');
    const strengthLabel = strengthBlock?.querySelector<HTMLParagraphElement>('.strength-label');
    const oauthGrid = modal.querySelector<HTMLDivElement>('.oauth-grid');
    const divider = modal.querySelector<HTMLDivElement>('.divider');
    const checkEmailView = modal.querySelector<HTMLDivElement>('.check-email-view');
    const authFormView = modal.querySelector<HTMLDivElement>('.auth-form-view');
    const checkEmailAddress = modal.querySelector<HTMLElement>('#check-email-address');
    const signinOnly = modal.querySelectorAll<HTMLElement>('.signin-only');
    const signupOnly = modal.querySelectorAll<HTMLElement>('.signup-only');
    const forgotOnly = modal.querySelectorAll<HTMLElement>('.forgot-only');

    let view: View = 'sign_in';
    let loading = false;

    const STRENGTH_LABELS = ['Very weak', 'Weak', 'Fair', 'Strong', 'Very strong'];

    // Toggle visibility via inline style (NOT just the [hidden] attribute) so
    // we can't lose to a more-specific .password-strength { display: flex }
    // rule under Astro's scoped-CSS specificity.
    function setHidden(el: HTMLElement | null | undefined, hidden: boolean) {
      if (!el) return;
      el.hidden = hidden;
      if (hidden) {
        el.style.display = 'none';
      } else {
        el.style.removeProperty('display');
      }
    }

    function getStrength() {
      const pw = passwordInput?.value ?? '';
      if (!pw) return null;
      return zxcvbn(pw);
    }

    function renderStrength() {
      if (!strengthBlock || !strengthBars || !strengthLabel) return;
      if (view !== 'sign_up') {
        setHidden(strengthBlock, true);
        return;
      }
      const result = getStrength();
      if (!result) {
        setHidden(strengthBlock, true);
        return;
      }
      setHidden(strengthBlock, false);
      const score = result.score;
      strengthBars.forEach((bar, i) => {
        bar.classList.toggle('active', i <= score);
        bar.dataset.score = String(score);
      });
      let labelText = STRENGTH_LABELS[score];
      if (result.feedback?.warning) {
        labelText += ` — ${result.feedback.warning}`;
      }
      strengthLabel.textContent = labelText;
      strengthLabel.dataset.score = String(score);
    }

    function setLoading(next: boolean) {
      loading = next;
      if (!submitBtn) return;
      submitBtn.disabled = next;
      const labels: Record<View, string> = {
        sign_in: 'Sign in',
        sign_up: 'Create account',
        forgot_password: 'Send reset link',
        check_email: '',
      };
      submitBtn.textContent = next ? 'Please wait...' : labels[view];
      modal!.querySelectorAll<HTMLButtonElement>('.oauth-btn').forEach((b) => {
        b.disabled = next;
      });
    }

    function showError(msg: string | null) {
      if (!errorEl) return;
      if (msg) {
        // Flash so a repeat error (e.g. "Please choose a stronger password.")
        // re-registers visually instead of looking like the button did nothing.
        setHidden(errorEl, true);
        void errorEl.offsetHeight;
        errorEl.textContent = msg;
        setHidden(errorEl, false);
      } else {
        errorEl.textContent = '';
        setHidden(errorEl, true);
      }
    }

    function setView(next: View) {
      view = next;
      showError(null);

      if (next === 'check_email') {
        setHidden(authFormView, true);
        setHidden(checkEmailView, false);
        if (titleEl) titleEl.textContent = 'Check your email';
        return;
      }

      setHidden(authFormView, false);
      setHidden(checkEmailView, true);

      if (titleEl) {
        titleEl.textContent =
          next === 'sign_in' ? 'Sign in' :
          next === 'sign_up' ? 'Create account' :
          'Reset password';
      }

      const showOAuth = next === 'sign_in' || next === 'sign_up';
      setHidden(oauthGrid, !showOAuth);
      setHidden(divider, !showOAuth);

      setHidden(passwordField, next === 'forgot_password');
      if (passwordInput) {
        passwordInput.required = next !== 'forgot_password';
        passwordInput.autocomplete = next === 'sign_up' ? 'new-password' : 'current-password';
      }

      const isSignUp = next === 'sign_up';
      setHidden(confirmField, !isSignUp);
      if (confirmInput) confirmInput.required = isSignUp;
      renderStrength();

      signinOnly.forEach((el) => { setHidden(el, next !== 'sign_in'); });
      signupOnly.forEach((el) => { setHidden(el, next !== 'sign_up'); });
      forgotOnly.forEach((el) => { setHidden(el, next !== 'forgot_password'); });

      if (submitBtn && !loading) {
        submitBtn.textContent =
          next === 'sign_in' ? 'Sign in' :
          next === 'sign_up' ? 'Create account' :
          'Send reset link';
      }
    }

    function resetModal() {
      form?.reset();
      setHidden(strengthBlock, true);
      strengthBars?.forEach((bar) => {
        bar.classList.remove('active');
        bar.removeAttribute('data-score');
      });
      if (strengthLabel) {
        strengthLabel.textContent = '';
        strengthLabel.removeAttribute('data-score');
      }
      showError(null);
      setView('sign_in');
    }

    // Open / close triggers
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-open-signin]')) {
        e.preventDefault();
        resetModal();
        if (!modal.open) modal.showModal();
      } else if (target.closest('[data-close-signin]')) {
        if (modal.open) modal.close();
      }
    });

    // Native close (Esc key, modal.close(), backdrop click) — clear all
    // form state so the next open starts from a blank sign-in view.
    modal.addEventListener('close', () => {
      resetModal();
    });

    // View navigation buttons (data-goto)
    modal.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest<HTMLElement>('[data-goto]');
      if (!trigger) return;
      e.preventDefault();
      const next = trigger.dataset.goto as View;
      if (next) setView(next);
    });

    passwordInput?.addEventListener('input', renderStrength);

    // Email/password submit — flow matches fiction AuthModal.handleEmailAuth.
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (loading) return;
      showError(null);

      const email = (emailInput?.value ?? '').trim();
      const password = passwordInput?.value ?? '';
      const confirmPassword = confirmInput?.value ?? '';

      try {
        if (view === 'sign_up') {
          const strength = getStrength();
          if (!strength || strength.score < 3) {
            showError('Please choose a stronger password.');
            return;
          }
          if (password !== confirmPassword) {
            showError('Passwords do not match.');
            return;
          }
          setLoading(true);
          const supabase = getBrowserClient();
          const { error } = await supabase.auth.signUp({
            email,
            password,
            options: { emailRedirectTo: `${window.location.origin}/auth/confirmed` },
          });
          if (error) { showError(error.message); setLoading(false); return; }
          if (checkEmailAddress) checkEmailAddress.textContent = email;
          setLoading(false);
          setView('check_email');
        } else if (view === 'sign_in') {
          setLoading(true);
          const supabase = getBrowserClient();
          const { data, error } = await supabase.auth.signInWithPassword({ email, password });
          if (error) { showError(error.message); setLoading(false); return; }
          if (!data?.session) {
            showError('Sign-in returned no session. Email may not be confirmed yet.');
            setLoading(false);
            return;
          }
          console.info('[auth] sign-in OK', data.user?.email);
          // Reload so server-rendered Nav/account state picks up the new
          // session. Middleware on the next request will refresh cookies.
          window.location.reload();
        } else if (view === 'forgot_password') {
          setLoading(true);
          const supabase = getBrowserClient();
          const { error } = await supabase.auth.resetPasswordForEmail(email, {
            redirectTo: `${window.location.origin}/auth/callback?next=/account/update-password`,
          });
          if (error) { showError(error.message); setLoading(false); return; }
          if (checkEmailAddress) checkEmailAddress.textContent = email;
          setLoading(false);
          setView('check_email');
        }
      } catch (err: any) {
        showError(err?.message ?? 'Something went wrong. Try again.');
        setLoading(false);
      }
    });

    // OAuth — matches fiction AuthModal.handleOAuthLogin.
    modal.querySelectorAll<HTMLButtonElement>('.oauth-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (loading) return;
        showError(null);
        setLoading(true);
        const provider = btn.dataset.provider as 'apple' | 'github' | 'facebook' | 'google';
        try {
          const supabase = getBrowserClient();
          const { error } = await supabase.auth.signInWithOAuth({
            provider,
            options: {
              redirectTo: `${window.location.origin}/auth/callback?next=${encodeURIComponent(window.location.pathname)}`,
            },
          });
          if (error) { showError(error.message); setLoading(false); }
        } catch (err: any) {
          showError(err?.message ?? 'OAuth sign-in failed.');
          setLoading(false);
        }
      });
    });
  }
</script>

<style>
  /* `<dialog>` element opens in the top layer; we layout content via the
     inner card. The dialog itself fills the viewport so the backdrop and
     card click-zones are predictable. Top-aligned at 20vh to match fiction. */
  .signin-modal {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    inset: 0;
    margin: 0;
    overflow: visible;
  }
  .signin-modal::backdrop {
    background: rgba(26, 22, 20, 0.4);
    backdrop-filter: blur(2px);
  }

  /* Make the [hidden] attribute always win over our display rules. */
  .signin-modal [hidden] { display: none !important; }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(26, 22, 20, 0.4);
    backdrop-filter: blur(2px);
    cursor: pointer;
  }

  .modal-card {
    position: relative;
    width: 100%;
    max-width: 24rem;
    margin: 20vh auto 1rem;
    background: var(--paper, #f5efe2);
    border: 1px solid var(--ink-200, #d4cab2);
    border-radius: 8px;
    box-shadow: 0 30px 60px -20px rgba(26, 22, 20, 0.35);
    color: var(--ink-900, #1c1814);
    overflow: hidden;
    animation: signin-modal-in 0.2s ease-out;
  }
  @keyframes signin-modal-in {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .modal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 1.5rem 0;
  }
  .modal-head h2 {
    font-family: var(--serif, Georgia, serif);
    font-size: 1.5rem;
    margin: 0;
    color: var(--ink-900);
  }
  .close {
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--ink-500, #6e665a);
    padding: 0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s;
  }
  .close:hover { color: var(--ink-900); }

  .modal-body {
    padding: 1rem 1.5rem 1.5rem;
  }

  /* Check-email view */
  .check-email-view {
    text-align: center;
    padding: 0.5rem 0 0.25rem;
  }
  .check-email-msg {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--ink-700, #2e2820);
    line-height: 1.55;
    margin: 0;
  }
  .check-email-view .back-to-signin {
    margin-top: 1.5rem;
    font-size: 0.875rem;
  }

  /* OAuth grid */
  .oauth-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .oauth-btn {
    background: var(--paper);
    border: 1px solid var(--ink-200);
    padding: 0 0.75rem;
    height: 2.75rem;
    cursor: pointer;
    font-size: 0.9375rem;
    color: var(--ink-900);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 6px;
    transition: border-color 0.15s, background 0.15s;
  }
  .oauth-btn:hover { border-color: var(--ink-500); background: #ede5cf; }
  .oauth-btn:disabled { opacity: 0.5; cursor: default; }
  .oauth-btn svg { flex: none; }

  /* Divider */
  .divider {
    text-align: center;
    margin: 1.25rem 0;
    position: relative;
    color: var(--ink-500);
    font-size: 0.75rem;
  }
  .divider::before,
  .divider::after {
    content: '';
    position: absolute;
    top: 50%;
    width: calc(50% - 1.25rem);
    height: 1px;
    background: var(--ink-200);
  }
  .divider::before { left: 0; }
  .divider::after { right: 0; }
  .divider span { background: var(--paper); padding: 0 0.5rem; position: relative; z-index: 1; }

  /* Form */
  .email-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .field-label {
    font-family: var(--sans, system-ui);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-500);
    font-weight: 600;
  }
  .email-form input {
    height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--ink-200);
    background: var(--paper);
    font-size: 1rem;
    font-family: var(--serif);
    color: var(--ink-900);
    border-radius: 6px;
    transition: border-color 0.15s;
  }
  .email-form input:focus {
    outline: 0;
    border-color: var(--accent-color, #156082);
  }
  .email-form input::placeholder { color: var(--ink-300, #b4aa98); }

  /* Password strength */
  .password-strength {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .strength-bars {
    display: flex;
    gap: 0.25rem;
  }
  .strength-bars .bar {
    flex: 1;
    height: 3px;
    background: var(--ink-200);
    border-radius: 2px;
    transition: background-color 0.15s;
  }
  .strength-bars .bar.active[data-score="0"] { background: #8b4049; }
  .strength-bars .bar.active[data-score="1"] { background: #9e6a3a; }
  .strength-bars .bar.active[data-score="2"] { background: #8a7e3e; }
  .strength-bars .bar.active[data-score="3"] { background: #4a7a5c; }
  .strength-bars .bar.active[data-score="4"] { background: #2a6b5a; }
  .strength-label {
    font-family: var(--sans, system-ui);
    font-size: 0.75rem;
    color: var(--ink-500);
    margin: 0;
  }
  .strength-label[data-score="3"],
  .strength-label[data-score="4"] { color: #4a7a5c; }

  /* Error */
  .form-error {
    margin: 0;
    color: #a13d2c;
    font-size: 0.875rem;
  }

  /* Submit */
  .submit {
    height: 2.75rem;
    background: var(--ink-900);
    color: var(--paper);
    border: 0;
    padding: 0 1rem;
    font-family: var(--sans, system-ui);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
