---
// CartIcon — links to /cart with a count badge driven by localStorage.
// The badge updates live via the cart pub-sub in lib/cart.ts.
---

<a href="/cart" class="cart-icon" aria-label="Cart">
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <path
      d="M3 4h2l2.6 12.4a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.5L21 8H6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx="9" cy="20" r="1.4" fill="currentColor" />
    <circle cx="17" cy="20" r="1.4" fill="currentColor" />
  </svg>
  <span class="cart-count" data-cart-count hidden>0</span>
</a>

<script>
  import { getCart, onCartChange } from '../lib/cart';

  function update() {
    const count = getCart().length;
    document.querySelectorAll<HTMLSpanElement>('[data-cart-count]').forEach((el) => {
      if (count > 0) {
        el.textContent = String(count);
        el.hidden = false;
      } else {
        el.hidden = true;
      }
    });
  }

  update();
  onCartChange(update);
</script>

<style>
  .cart-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-900, #1c1814);
    padding: 0.4rem;
  }
  .cart-icon:hover { color: var(--ink-500, #6e665a); }
  .cart-count {
    position: absolute;
    top: -2px;
    right: -2px;
    background: var(--ink-900);
    color: var(--paper, #f5efe2);
    font-size: 0.6875rem;
    font-weight: 600;
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 5px;
    line-height: 1;
  }
</style>
