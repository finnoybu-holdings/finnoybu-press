---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createClient } from '../../../lib/supabase/server';

export const prerender = false;

// Server-render-time gate: only signed-in users (including those just
// arriving from a password-recovery callback, who get an authenticated
// session via exchangeCodeForSession) should see the form. Everyone
// else sees the "this link has expired" message.
let signedIn = false;
try {
  if (import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY) {
    const supabase = createClient(Astro.cookies);
    const { data } = await supabase.auth.getUser();
    signedIn = !!data.user;
  }
} catch {
  signedIn = false;
}
---
<BaseLayout
  title="Set a new password — Finnoybu Press"
  description="Choose a new password for your Finnoybu Press account."
>
  <article class="update-password-page">
    <div class="container narrow">
      {signedIn ? (
        <>
          <p class="eyebrow">Account</p>
          <h1>Set a new password.</h1>

          <!-- Form view (default) -->
          <div class="form-view">
            <form id="update-password-form" novalidate>
              <label>
                <span class="field-label">New password</span>
                <input type="password" name="password" autocomplete="new-password" placeholder="At least 8 characters" minlength="8" required autofocus />
              </label>

              <div class="password-strength" hidden>
                <div class="strength-bars">
                  <span class="bar" data-bar="0"></span>
                  <span class="bar" data-bar="1"></span>
                  <span class="bar" data-bar="2"></span>
                  <span class="bar" data-bar="3"></span>
                  <span class="bar" data-bar="4"></span>
                </div>
                <p class="strength-label"></p>
              </div>

              <label>
                <span class="field-label">Confirm password</span>
                <input type="password" name="confirm" autocomplete="new-password" placeholder="Re-enter your password" minlength="8" required />
              </label>

              <p class="form-error" id="form-error" hidden></p>

              <button type="submit" class="submit">Save new password</button>
            </form>
          </div>

          <!-- Done view (after successful update) -->
          <div class="done-view" hidden>
            <h2>Password updated.</h2>
            <p class="lede">Your password has been changed. Please sign in with your new password.</p>
            <button type="button" class="btn" data-open-signin>Sign in</button>
          </div>
        </>
      ) : (
        <>
          <p class="eyebrow">Link expired</p>
          <h1>This link has expired or is invalid.</h1>
          <p class="lede">
            Password-reset links expire after one hour. Request a new one from the sign-in page,
            or sign in directly if you remember your password.
          </p>
          <button type="button" class="btn" data-open-signin>Sign in</button>
        </>
      )}
    </div>
  </article>
</BaseLayout>

<script>
  import { getBrowserClient } from '../../../lib/supabase/client';

  const form = document.getElementById('update-password-form') as HTMLFormElement | null;
  if (form) {
    const passwordInput = form.querySelector<HTMLInputElement>('input[name="password"]');
    const confirmInput = form.querySelector<HTMLInputElement>('input[name="confirm"]');
    const submitBtn = form.querySelector<HTMLButtonElement>('button.submit');
    const errorEl = document.getElementById('form-error') as HTMLParagraphElement | null;
    const strengthBlock = form.querySelector<HTMLDivElement>('.password-strength');
    const strengthBars = strengthBlock?.querySelectorAll<HTMLSpanElement>('.bar');
    const strengthLabel = strengthBlock?.querySelector<HTMLParagraphElement>('.strength-label');
    const formView = document.querySelector<HTMLDivElement>('.form-view');
    const doneView = document.querySelector<HTMLDivElement>('.done-view');

    function strengthScore(pw: string) {
      if (!pw) return { score: 0, label: '' };
      let score = 0;
      if (pw.length >= 8) score++;
      if (pw.length >= 12) score++;
      const classes = [/[a-z]/, /[A-Z]/, /\d/, /[^a-zA-Z0-9]/].filter((re) => re.test(pw)).length;
      score += Math.max(0, classes - 1);
      score = Math.min(4, score);
      return { score, label: ['Very weak', 'Weak', 'Fair', 'Strong', 'Very strong'][score] };
    }

    function updateStrength() {
      if (!strengthBlock || !strengthBars || !strengthLabel) return;
      const pw = passwordInput?.value ?? '';
      if (!pw) { strengthBlock.hidden = true; return; }
      strengthBlock.hidden = false;
      const { score, label } = strengthScore(pw);
      strengthBars.forEach((bar, i) => {
        bar.classList.toggle('active', i <= score);
        bar.dataset.score = String(score);
      });
      strengthLabel.textContent = label;
      strengthLabel.dataset.score = String(score);
    }

    function showError(msg: string | null) {
      if (!errorEl) return;
      if (msg) { errorEl.textContent = msg; errorEl.hidden = false; }
      else { errorEl.textContent = ''; errorEl.hidden = true; }
    }

    passwordInput?.addEventListener('input', updateStrength);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      showError(null);
      const password = passwordInput?.value ?? '';
      const confirm = confirmInput?.value ?? '';

      const { score } = strengthScore(password);
      if (score < 2) { showError('Please choose a stronger password.'); return; }
      if (password !== confirm) { showError('Passwords do not match.'); return; }

      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Saving…'; }

      try {
        const supabase = getBrowserClient();
        const { error } = await supabase.auth.updateUser({ password });
        if (error) {
          showError(error.message);
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Save new password'; }
          return;
        }
        // Sign out so user must re-authenticate with the new password.
        await supabase.auth.signOut();
        if (formView) formView.hidden = true;
        if (doneView) doneView.hidden = false;
      } catch (err: any) {
        showError(err?.message ?? 'Something went wrong. Try again.');
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Save new password'; }
      }
    });
  }
</script>

<style>
  .update-password-page {
    padding-block: var(--space-5) var(--space-7);
  }
  .narrow { max-width: 420px; }

  .eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-color, #156082);
    margin-bottom: var(--space-2);
  }

  h1 {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.15;
    margin: 0 0 var(--space-3);
    color: var(--ink-900);
  }

  h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    margin: 0 0 var(--space-2);
    color: var(--ink-900);
  }

  .lede {
    font-family: var(--serif);
    color: var(--ink-700, #2e2820);
    font-size: 1rem;
    line-height: 1.55;
    margin-bottom: var(--space-3);
  }

  #update-password-form {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  #update-password-form label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .field-label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-500);
    font-weight: 600;
  }
  #update-password-form input {
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--ink-200);
    background: var(--paper);
    font-size: 0.9375rem;
    font-family: inherit;
    color: var(--ink-900);
    border-radius: 4px;
  }
  #update-password-form input:focus {
    outline: 2px solid var(--ink-700, #2e2820);
    outline-offset: -1px;
  }

  .password-strength {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .strength-bars {
    display: flex;
    gap: 0.25rem;
  }
  .strength-bars .bar {
    flex: 1;
    height: 3px;
    background: var(--ink-200);
    border-radius: 2px;
    transition: background-color 0.15s;
  }
  .strength-bars .bar.active[data-score="0"] { background: #8b4049; }
  .strength-bars .bar.active[data-score="1"] { background: #9e6a3a; }
  .strength-bars .bar.active[data-score="2"] { background: #8a7e3e; }
  .strength-bars .bar.active[data-score="3"] { background: #4a7a5c; }
  .strength-bars .bar.active[data-score="4"] { background: #2a6b5a; }
  .strength-label {
    font-size: 0.75rem;
    color: var(--ink-500);
    margin: 0;
  }
  .strength-label[data-score="3"],
  .strength-label[data-score="4"] { color: #4a7a5c; }

  .form-error {
    margin: 0;
    color: #a13d2c;
    font-size: 0.875rem;
  }

  .submit {
    background: var(--ink-900);
    color: var(--paper);
    border: 0;
    padding: 0.75rem;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    margin-top: 0.25rem;
    border-radius: 4px;
  }
  .submit:hover { background: #2e2820; }
  .submit:disabled { opacity: 0.6; cursor: default; }
</style>
