---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;
---
<BaseLayout
  title="Account confirmed — Finnoybu Press"
  description="Your email has been confirmed."
>
  <article class="confirmed-page">
    <div class="container inner">
      <p class="eyebrow">Account confirmed</p>
      <h1>You're all set.</h1>
      <p class="lede">
        Your email has been confirmed. Sign in to start reading with your full library.
      </p>
      <button type="button" class="btn" data-open-signin>Sign in</button>
    </div>
  </article>
</BaseLayout>

<script>
  // Sign the user out on land so they must explicitly sign in. This avoids
  // a confusing state where the email-confirm flow auto-signs them in but
  // the rest of the site doesn't yet show a session (cookies not synced).
  import { getBrowserClient } from '../../lib/supabase/client';
  const supabase = getBrowserClient();
  supabase.auth.signOut();
</script>

<style>
  .confirmed-page {
    padding-block: var(--space-6) var(--space-7);
    text-align: center;
  }
  .inner {
    max-width: 480px;
  }
  .eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-color, #156082);
    margin-bottom: var(--space-2);
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
    margin: 0 0 var(--space-2);
    color: var(--ink-900);
  }
  .lede {
    font-family: var(--serif);
    color: var(--ink-700, #2e2820);
    font-size: 1.0625rem;
    line-height: 1.55;
    margin-bottom: var(--space-4);
  }
</style>
