{
  "name": "finnoybu-press",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "Finnoybu Press — AI guides for every user (press.finnoybu.org)",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "wrangler pages dev ./dist",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply finnoybu-press --local",
    "db:migrate:prod": "wrangler d1 migrations apply finnoybu-press --remote",
    "r2:sync": "node scripts/upload-r2.mjs",
    "lock:wsl": "wsl -e bash -c \"npm install --package-lock-only\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^5.1.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "stripe": "^22.0.1",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251005.0",
    "drizzle-kit": "^0.31.0",
    "wrangler": "^3.95.0"
  }
}
